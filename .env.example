# Copy this file to .env and fill in real values. .env is git-ignored.
POSTGRES_DB=customer_db
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_pass

SNOWFLAKE_ACCOUNT=your_account.your_region
SNOWFLAKE_USER=PIPELINE_SVC_USER
SNOWFLAKE_PRIVATE_KEY=paste_private_key_body_here_single_line
SNOWFLAKE_PRIVATE_KEY_PATH=./snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=PIPELINE_WH
SNOWFLAKE_DATABASE=CUSTOMER_PIPELINE
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_ANALYTICS_SCHEMA=ANALYTICS

CONNECT_URL=http://localhost:8083
